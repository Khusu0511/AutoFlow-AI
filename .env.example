# --- LLM ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# gemini-3.5-flash (default) or the cheaper gemini-2.5-flash
WORKER_MODEL=gemini-3.5-flash
# USD per million tokens, used only for the cost cap (3.5-flash: 1.5 / 9; 2.5-flash: 0.3 / 2.5)
PRICE_IN_PER_MTOK=1.5
PRICE_OUT_PER_MTOK=9

# --- Services (defaults shown) ---
VENDOR_URL=http://localhost:8001
FINANCEDESK_URL=http://localhost:8002
BROWSER_URL=http://localhost:4000

# --- MySQL (FinanceDesk) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=financedesk

# --- Credentials the agent may fetch with get_credentials ---
VENDOR_USER=ap@company.test
VENDOR_PASSWORD=vendor-pass
FINANCEDESK_USER=clerk
FINANCEDESK_PASSWORD=desk-pass

# --- Fault injection for FinanceDesk (see README): e.g. err500=0.3,rename_btn,expire_after=4,slow=2
FAULTS=
